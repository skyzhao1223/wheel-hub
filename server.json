{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.skyzhao1223/wheel-hub",
  "title": "wheel-hub",
  "description": "MCP server that scores existing open-source solutions on GitHub before you reinvent the wheel.",
  "version": "0.1.3",
  "repository": {
    "url": "https://github.com/skyzhao1223/wheel-hub",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@wheel-hub/mcp",
      "version": "0.1.3",
      "transport": {
        "type": "stdio",
        "command": "wheel-hub-mcp"
      }
    }
  ],
  "runtime": {
    "type": "node",
    "version": "24"
  }
}
