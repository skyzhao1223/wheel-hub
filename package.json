{
  "name": "wheelhub",
  "version": "0.1.0",
  "private": true,
  "description": "Stop reinventing the wheel. Search, score and adopt the best open-source solutions before you write a line of code.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "open-source",
    "mcp",
    "cli",
    "developer-tools",
    "awesome"
  ],
  "license": "MIT"
}
